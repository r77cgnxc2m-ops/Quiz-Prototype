
/* =========================
   LOAD QUESTIONS (single source of truth)
========================= */
function getQuestions() {
  return JSON.parse(localStorage.getItem("questions")) || [];
}

/* =========================
   SAVE QUESTIONS
========================= */
function saveQuestions(questions) {
  localStorage.setItem("questions", JSON.stringify(questions));
}

/* =========================
   ADMIN FUNCTION: ADD QUESTION
========================= */
function addQuestion(q, a) {
  let questions = getQuestions();

  questions.push({
    question: q,
    answer: a
  });

  saveQuestions(questions);
}

/* =========================
   QUIZ STATE (student only)
========================= */
let current = 0;
let score = 0;
let wrongAnswers = [];
let quizQuestions = [];

/* =========================
   START QUIZ
========================= */
function startQuiz() {
  quizQuestions = getQuestions();

  current = 0;
  score = 0;
  wrongAnswers = [];
}

/* =========================
   CHECK ANSWER
========================= */
function checkAnswer(userAnswer) {
  if (!quizQuestions || quizQuestions.length === 0) return;

  let correct = quizQuestions[current].answer;

  if (userAnswer.trim().toLowerCase() === correct.trim().toLowerCase()) {
    score++;
  } else {
    wrongAnswers.push({
      question: quizQuestions[current].question,
      correct: correct,
      user: userAnswer
    });
  }

  current++;
}

/* =========================
   RESULT MESSAGE
========================= */
function getResultMessage() {
  if (score >= 8) return "Excellent";
  if (score >= 5) return "Good";
  return "Needs more revision";
}
