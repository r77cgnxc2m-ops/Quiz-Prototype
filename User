<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Sign in</title>

  <style>
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Arial, sans-serif;
      background-color: #f5f5f7;
      display: flex;
      justify-content: center;
      align-items: center;
      height: 100vh;
    }

    .container {
      background: #fff;
      padding: 40px 30px;
      width: 100%;
      max-width: 380px;
      border-radius: 16px;
      box-shadow: 0 10px 25px rgba(0,0,0,0.08);
      text-align: center;
    }

    .logo {
      font-size: 28px;
      margin-bottom: 20px;
    }

    h1 {
      font-size: 22px;
      font-weight: 500;
      margin-bottom: 25px;
      color: #1d1d1f;
    }

    .input-group {
      position: relative;
      margin-bottom: 15px;
    }

    input {
      width: 100%;
      padding: 14px 12px;
      border: 1px solid #d2d2d7;
      border-radius: 10px;
      font-size: 16px;
      outline: none;
      transition: 0.2s;
    }

    input:focus {
      border-color: #0071e3;
      box-shadow: 0 0 0 3px rgba(0,113,227,0.15);
    }

    button {
      width: 100%;
      padding: 14px;
      margin-top: 10px;
      border: none;
      border-radius: 10px;
      background-color: #0071e3;
      color: white;
      font-size: 16px;
      cursor: pointer;
      transition: 0.2s;
    }

    button:hover {
      background-color: #005bb5;
    }

    .links {
      margin-top: 20px;
      font-size: 14px;
    }

    .links a {
      color: #0071e3;
      text-decoration: none;
    }

    .links a:hover {
      text-decoration: underline;
    }

    .footer {
      margin-top: 25px;
      font-size: 12px;
      color: #6e6e73;
    }
  </style>
</head>

<body>

  <div class="container">
    <div class="logo"></div>

    <h1>Sign in with your account</h1>

    <form>
      <div class="input-group">
        <input type="email" placeholder="Email or Phone Number" required>
      </div>

      <div class="input-group">
        <input type="password" placeholder="Password" required>
      </div>

      <button type="submit">Sign In</button>
    </form>

    <div class="links">
      <p><a href="#">Forgot password?</a></p>
      <p><a href="#">Create your account</a></p>
    </div>

    <div class="footer">
      <p>© 2026 All rights reserved</p>
    </div>
  </div>

</body>
</html>
